NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=3001
DATABASE_URL=sqlite:./data/weplay.db
# DATABASE_URL=postgres://weplay:weplay@localhost:5432/weplay
CORS_ORIGIN=http://localhost:5173
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h
WORKER_TOKEN_SECRET=change-me-to-another-long-random-string
HEARTBEAT_TIMEOUT_MS=30000
CONTROLLER_TICK_MS=1000
JOB_STALE_MS=120000
MAX_JOB_RETRIES=3
DEFAULT_INTERVAL_MS=5000
ALLOWED_DURATIONS_MS=60000,180000,300000,900000
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=changeme


# Google Workspace Admin SDK (Directory API users.insert). Backend only — never expose these to the web app.
# Create users in YOUR Workspace organization. Does not create consumer Google accounts.
GOOGLE_WORKSPACE_DOMAIN=businessdost.online
GOOGLE_WORKSPACE_ADMIN_EMAIL=kabeer@businessdost.online
GOOGLE_WORKSPACE_ADMIN_PASSWORD=Kabeer@786
# Path is relative to the repository root (not apps/api).
GOOGLE_WORKSPACE_SERVICE_ACCOUNT_FILE=secrets/credible-skill-506608-r7-146b258178f4.json
GOOGLE_WORKSPACE_SERVICE_ACCOUNT_JSON=
GOOGLE_WORKSPACE_PROVISION_CONCURRENCY=4
GOOGLE_WORKSPACE_PROVISION_MAX_RETRIES=5
GOOGLE_WORKSPACE_PROVISION_INITIAL_BACKOFF_MS=1000

# Shared Google password for every Workspace Directory user and Device Farm Google sign-in.
# Fill this in, then restart the API. Never committed or logged.
